<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <key>LSMinimumSystemVersion</key><string>26.0</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key><string>com.mugenzip.app</string>
            <key>CFBundleURLSchemes</key>
            <array><string>mugenzip</string></array>
        </dict>
    </array>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key><string>Archive</string>
            <key>CFBundleTypeRole</key><string>Viewer</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>zip</string>
                <string>cbz</string>
                <string>jar</string>
                <string>tar</string>
                <string>tar.gz</string>
                <string>tgz</string>
                <string>tar.bz2</string>
                <string>tbz2</string>
                <string>tar.xz</string>
                <string>txz</string>
                <string>7z</string>
                <string>rar</string>
            </array>
        </dict>
    </array>
    <!-- Finder's 服务 submenu. Each entry's NSMessage is the selector the provider
         receives; src/app.rs registers the same list at launch, so the two must stay
         in step. The two 解压 entries work in place: no archive is opened, the app
         hides itself after the activation and reveals the result in Finder. -->
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key><dict><key>default</key><string>用 MugenZip 打开</string></dict>
            <key>NSMessage</key><string>coveOpenService:</string>
            <key>NSSendFileTypes</key><array><string>public.zip-archive</string><string>com.rarlab.rar-archive</string><string>org.7-zip.7-zip-archive</string><string>public.tar-archive</string><string>org.gnu.gnu-zip-archive</string><string>public.bzip2-archive</string><string>public.xz-archive</string></array>
        </dict>
        <dict>
            <key>NSMenuItem</key><dict><key>default</key><string>解压到当前目录</string></dict>
            <key>NSMessage</key><string>coveExtractHereService:</string>
            <key>NSSendFileTypes</key><array><string>public.zip-archive</string><string>com.rarlab.rar-archive</string><string>org.7-zip.7-zip-archive</string><string>public.tar-archive</string><string>org.gnu.gnu-zip-archive</string><string>public.bzip2-archive</string><string>public.xz-archive</string></array>
        </dict>
        <dict>
            <key>NSMenuItem</key><dict><key>default</key><string>解压到同名目录</string></dict>
            <key>NSMessage</key><string>coveExtractFolderService:</string>
            <key>NSSendFileTypes</key><array><string>public.zip-archive</string><string>com.rarlab.rar-archive</string><string>org.7-zip.7-zip-archive</string><string>public.tar-archive</string><string>org.gnu.gnu-zip-archive</string><string>public.bzip2-archive</string><string>public.xz-archive</string></array>
        </dict>
        <dict>
            <key>NSMenuItem</key><dict><key>default</key><string>智能解压到同名目录</string></dict>
            <key>NSMessage</key><string>coveSmartExtractService:</string>
            <key>NSSendFileTypes</key><array><string>public.zip-archive</string><string>com.rarlab.rar-archive</string><string>org.7-zip.7-zip-archive</string><string>public.tar-archive</string><string>org.gnu.gnu-zip-archive</string><string>public.bzip2-archive</string><string>public.xz-archive</string></array>
        </dict>
        <dict>
            <key>NSMenuItem</key><dict><key>default</key><string>压缩至 ZIP</string></dict>
            <key>NSMessage</key><string>coveCompressZipService:</string>
            <key>NSSendFileTypes</key><array><string>public.item</string><string>public.folder</string></array>
        </dict>
        <dict>
            <key>NSMenuItem</key><dict><key>default</key><string>压缩至 7Z</string></dict>
            <key>NSMessage</key><string>coveCompressSevenZService:</string>
            <key>NSSendFileTypes</key><array><string>public.item</string><string>public.folder</string></array>
        </dict>
        <dict>
            <key>NSMenuItem</key><dict><key>default</key><string>在 MugenZip 中压缩</string></dict>
            <key>NSMessage</key><string>coveCompressPanelService:</string>
            <key>NSSendFileTypes</key><array><string>public.item</string><string>public.folder</string></array>
        </dict>
        <dict>
            <key>NSMenuItem</key><dict><key>default</key><string>校验 CRC32</string></dict>
            <key>NSMessage</key><string>coveHashCrc32Service:</string>
            <key>NSSendFileTypes</key><array><string>public.item</string></array>
        </dict>
        <dict>
            <key>NSMenuItem</key><dict><key>default</key><string>校验 MD5</string></dict>
            <key>NSMessage</key><string>coveHashMd5Service:</string>
            <key>NSSendFileTypes</key><array><string>public.item</string></array>
        </dict>
        <dict>
            <key>NSMenuItem</key><dict><key>default</key><string>校验 SHA-1</string></dict>
            <key>NSMessage</key><string>coveHashSha1Service:</string>
            <key>NSSendFileTypes</key><array><string>public.item</string></array>
        </dict>
        <dict>
            <key>NSMenuItem</key><dict><key>default</key><string>校验 SHA-256</string></dict>
            <key>NSMessage</key><string>coveHashSha256Service:</string>
            <key>NSSendFileTypes</key><array><string>public.item</string></array>
        </dict>
        <dict>
            <key>NSMenuItem</key><dict><key>default</key><string>校验 SHA-512</string></dict>
            <key>NSMessage</key><string>coveHashSha512Service:</string>
            <key>NSSendFileTypes</key><array><string>public.item</string></array>
        </dict>
    </array>
</dict></plist>
