<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <key>LSMinimumSystemVersion</key><string>26.0</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key><string>com.mugenzip.app</string>
            <key>CFBundleURLSchemes</key>
            <array><string>mugenzip</string></array>
        </dict>
    </array>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key><string>Archive</string>
            <key>CFBundleTypeRole</key><string>Viewer</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>zip</string>
                <string>cbz</string>
                <string>jar</string>
                <string>tar</string>
                <string>tar.gz</string>
                <string>tgz</string>
                <string>tar.bz2</string>
                <string>tbz2</string>
                <string>tar.xz</string>
                <string>txz</string>
                <string>7z</string>
                <string>rar</string>
            </array>
        </dict>
    </array>
    <!-- Finder's 服务 submenu. Each entry's NSMessage is the selector the provider
         receives; src/app.rs registers the same list at launch, so the two must stay
         in step. The two 解压 entries work in place: no archive is opened, the app
         hides itself after the activation and reveals the result in Finder. -->
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key><dict><key>default</key><string>用 MugenZip 打开</string></dict>
            <key>NSMessage</key><string>coveOpenService:</string>
            <key>NSSendFileTypes</key><array><string>public.item</string></array>
        </dict>
        <dict>
            <key>NSMenuItem</key><dict><key>default</key><string>解压到此处</string></dict>
            <key>NSMessage</key><string>coveExtractHereService:</string>
            <key>NSSendFileTypes</key><array><string>public.item</string></array>
        </dict>
        <dict>
            <key>NSMenuItem</key><dict><key>default</key><string>解压到同名文件夹</string></dict>
            <key>NSMessage</key><string>coveExtractFolderService:</string>
            <key>NSSendFileTypes</key><array><string>public.item</string></array>
        </dict>
        <dict>
            <key>NSMenuItem</key><dict><key>default</key><string>压缩到此处</string></dict>
            <key>NSMessage</key><string>coveCompressHereService:</string>
            <key>NSSendFileTypes</key><array><string>public.item</string></array>
        </dict>
    </array>
</dict></plist>
