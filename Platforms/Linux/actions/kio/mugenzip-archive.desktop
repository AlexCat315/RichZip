[Desktop Entry]
Type=Service
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=application/zip;application/x-tar;application/x-7z-compressed;application/vnd.rar;application/gzip;application/x-xz;application/x-bzip2;application/x-compressed-tar;
Actions=Open;ExtractHere;ExtractFolder;SmartExtract;CompressZip;Compress7z;CompressTarGz;CompressUi;HashCrc32;HashMd5;HashSha1;HashSha256;HashSha512;
X-KDE-Priority=TopLevel
X-KDE-Submenu=MugenZip

[Desktop Action Open]
Name=在 MugenZip 打开
Icon=mugenzip
Exec=mugenzip --verb open %F

[Desktop Action ExtractHere]
Name=解压到当前目录
Icon=mugenzip
Exec=mugenzip --verb extract-here %F

[Desktop Action ExtractFolder]
Name=解压到同名目录
Icon=mugenzip
Exec=mugenzip --verb extract-folder %F

[Desktop Action SmartExtract]
Name=智能解压到同名目录
Icon=mugenzip
Exec=mugenzip --verb smart-extract %F

[Desktop Action CompressZip]
Name=压缩至 ZIP
Icon=mugenzip
Exec=mugenzip --verb compress-zip %F

[Desktop Action Compress7z]
Name=压缩至 7Z
Icon=mugenzip
Exec=mugenzip --verb compress-7z %F

[Desktop Action CompressTarGz]
Name=压缩至 TAR.GZ
Icon=mugenzip
Exec=mugenzip --verb compress-targz %F

[Desktop Action CompressUi]
Name=在 MugenZip 中压缩
Icon=mugenzip
Exec=mugenzip --verb compress-ui %F

[Desktop Action HashCrc32]
Name=校验 CRC32
Exec=mugenzip --verb hash-crc32 %F

[Desktop Action HashMd5]
Name=校验 MD5
Exec=mugenzip --verb hash-md5 %F

[Desktop Action HashSha1]
Name=校验 SHA-1
Exec=mugenzip --verb hash-sha1 %F

[Desktop Action HashSha256]
Name=校验 SHA-256
Exec=mugenzip --verb hash-sha256 %F

[Desktop Action HashSha512]
Name=校验 SHA-512
Exec=mugenzip --verb hash-sha512 %F
