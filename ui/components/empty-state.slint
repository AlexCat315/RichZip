import { Theme } from "../theme.slint";

// 空状态：线稿文件夹 + 三片樱瓣，整面可点击打开系统文件对话框
export component EmptyState inherits Rectangle {
    callback open-clicked();

    background: Theme.paper;

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open-clicked(); }
    }

    VerticalLayout {
        alignment: center;
        spacing: 14px;

        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 260px;
                height: 170px;

                Path {
                    width: 100%;
                    height: 100%;
                    viewbox-width: 260;
                    viewbox-height: 170;
                    fill: #FFFFFF;
                    stroke: #9B978C;
                    stroke-width: 1.8px;
                    MoveTo { x: 62; y: 52; }
                    LineTo { x: 108; y: 52; }
                    LineTo { x: 118; y: 64; }
                    LineTo { x: 198; y: 64; }
                    LineTo { x: 198; y: 130; }
                    LineTo { x: 62; y: 130; }
                    Close {}
                }
                Path {
                    width: 100%;
                    height: 100%;
                    viewbox-width: 260;
                    viewbox-height: 170;
                    fill: Theme.paper;
                    stroke: #9B978C;
                    stroke-width: 1.8px;
                    MoveTo { x: 62; y: 76; }
                    LineTo { x: 198; y: 76; }
                    LineTo { x: 198; y: 130; }
                    LineTo { x: 62; y: 130; }
                    Close {}
                }
                Path {
                    width: 100%;
                    height: 100%;
                    viewbox-width: 260;
                    viewbox-height: 170;
                    fill: Theme.sakura;
                    opacity: 0.9;
                    MoveTo { x: 74; y: 30; }
                    CubicTo { control-1-x: 84; control-1-y: 22; control-2-x: 96; control-2-y: 26; x: 97; y: 35; }
                    CubicTo { control-1-x: 91; control-1-y: 42; control-2-x: 79; control-2-y: 39; x: 74; y: 30; }
                    Close {}
                }
                Path {
                    width: 100%;
                    height: 100%;
                    viewbox-width: 260;
                    viewbox-height: 170;
                    fill: Theme.sakura;
                    opacity: 0.55;
                    MoveTo { x: 168; y: 18; }
                    CubicTo { control-1-x: 175; control-1-y: 12; control-2-x: 184; control-2-y: 15; x: 185; y: 22; }
                    CubicTo { control-1-x: 180; control-1-y: 27; control-2-x: 171; control-2-y: 25; x: 168; y: 18; }
                    Close {}
                }
                Path {
                    width: 100%;
                    height: 100%;
                    viewbox-width: 260;
                    viewbox-height: 170;
                    fill: Theme.sakura;
                    opacity: 0.35;
                    MoveTo { x: 214; y: 52; }
                    CubicTo { control-1-x: 220; control-1-y: 47; control-2-x: 228; control-2-y: 49; x: 229; y: 56; }
                    CubicTo { control-1-x: 225; control-1-y: 60; control-2-x: 217; control-2-y: 58; x: 214; y: 52; }
                    Close {}
                }
            }
        }

        HorizontalLayout {
            alignment: center;
            Text {
                text: "拖入压缩包到这里";
                color: Theme.ink;
                font-size: 16px;
                font-weight: 600;
            }
        }
        HorizontalLayout {
            alignment: center;
            Text {
                text: "或者点击工具栏的「打开压缩包」选择文件";
                color: Theme.ink-dim;
                font-size: 12px;
            }
        }
    }
}
