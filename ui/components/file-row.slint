import { Theme } from "../theme.slint";
import { Utils } from "../util.slint";

export struct FileItem {
    id: string,
    name: string,
    ext: string,
    size: string,
    modified: string,
    path: string,
    folder: bool,
}

export component FileRow inherits Rectangle {
    in property <FileItem> item;
    in property <bool> selected: false;
    callback clicked;
    callback activated;

    height: 34px;
    border-radius: 4px;
    background: root.selected ? Theme.sakura-soft : touch.has-hover ? #F0EEE7 : transparent;
    border-width: root.selected ? 1px : 0px;
    border-color: Theme.sakura;
    animate background { duration: 100ms; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        double-clicked => { root.activated(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;

        Rectangle {
            width: 34px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            background: transparent;

            if root.item.folder: Path {
                width: 20px;
                height: 16px;
                x: 3px;
                y: 3px;
                viewbox-width: 20;
                viewbox-height: 16;
                fill: Theme.kon;
                MoveTo { x: 1; y: 3; }
                LineTo { x: 7; y: 3; }
                LineTo { x: 9; y: 5; }
                LineTo { x: 19; y: 5; }
                LineTo { x: 19; y: 15; }
                LineTo { x: 1; y: 15; }
                Close {}
            }
            if !root.item.folder: Rectangle {
                width: 34px;
                height: 18px;
                y: 2px;
                border-radius: 3px;
                background: Utils.type-color(root.item.ext, false);

                Text {
                    text: root.item.ext;
                    color: #FFFFFF;
                    font-size: 9px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            text: root.item.name;
            color: Theme.ink;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            text: root.item.size;
            color: Theme.ink-dim;
            font-size: 12px;
            width: 76px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Text {
            text: root.item.modified;
            color: Theme.ink-dim;
            font-size: 12px;
            width: 86px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}
