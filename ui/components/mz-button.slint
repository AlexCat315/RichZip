import { Theme } from "../theme.slint";

export component MzButton inherits Rectangle {
    in property <string> text: "按钮";
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked;

    height: 30px;
    border-radius: Theme.radius;
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.edge;
    background: !root.enabled ? #EFEDE6
        : root.primary ? (touch.pressed ? Theme.kon-deep : touch.has-hover ? Theme.kon-hover : Theme.kon)
        : (touch.pressed ? Theme.mist : touch.has-hover ? #EFEDE6 : #FFFFFF);
    animate background { duration: 120ms; }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        Text {
            text: root.text;
            color: !root.enabled ? #A9A59A : root.primary ? #FFFFFF : Theme.ink;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
}
