import { Theme } from "../theme.slint";
import { Utils } from "../util.slint";
import { FileItem } from "file-row.slint";

component InfoRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;

    Text {
        text: root.label;
        width: 56px;
        horizontal-stretch: 0;
        color: Theme.ink-dim;
        font-size: 12px;
        vertical-alignment: center;
    }
    Text {
        text: root.value;
        color: Theme.ink;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: 1;
    }
}

export component DetailPanel inherits Rectangle {
    in property <FileItem> item;
    in property <bool> has-selection: false;

    background: #FCFBF8;

    if root.has-selection: VerticalLayout {
        padding: 18px;
        spacing: 10px;
        alignment: start;

        Rectangle {
            width: 54px;
            height: 34px;
            horizontal-stretch: 0;
            border-radius: 5px;
            background: Utils.type-color(root.item.ext, root.item.folder);

            Text {
                text: root.item.folder ? "目录" : root.item.ext;
                color: #FFFFFF;
                font-size: 12px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.item.name;
            color: Theme.ink;
            font-size: 15px;
            font-weight: 600;
            wrap: word-wrap;
        }
        Rectangle {
            height: 1px;
            vertical-stretch: 0;
            background: Theme.mist;
        }
        InfoRow { label: "大小"; value: root.item.size; vertical-stretch: 0; }
        InfoRow { label: "类型"; value: root.item.folder ? "文件夹" : root.item.ext + " 文件"; vertical-stretch: 0; }
        InfoRow { label: "修改日期"; value: root.item.modified; vertical-stretch: 0; }
        InfoRow { label: "位置"; value: root.item.path; vertical-stretch: 0; }

        Rectangle { vertical-stretch: 1; }
    }

    if !root.has-selection: HorizontalLayout {
        alignment: center;
        Text {
            text: "选择一个文件，查看详情";
            color: #A9A59A;
            font-size: 12px;
            y: (parent.height - self.height) / 2;
        }
    }
}
