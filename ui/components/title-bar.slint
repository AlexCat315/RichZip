import { Theme } from "../theme.slint";

component WinButton inherits Rectangle {
    in property <bool> close: false;
    callback clicked;

    width: 44px;
    background: touch.pressed ? (root.close ? #B0455B : Theme.kon-hover)
        : touch.has-hover ? (root.close ? #C75463 : Theme.kon-hover)
        : transparent;
    animate background { duration: 100ms; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    if !root.close: Rectangle {
        width: 11px;
        height: 1.5px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + 3px;
        background: #FFFFFF;
    }
    if root.close: Path {
        width: 12px;
        height: 12px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        stroke: #FFFFFF;
        stroke-width: 1.5px;
        MoveTo { x: 1; y: 1; }
        LineTo { x: 11; y: 11; }
        MoveTo { x: 11; y: 1; }
        LineTo { x: 1; y: 11; }
    }
}

export component TitleBar inherits Rectangle {
    callback move-window(length, length);
    callback minimize-clicked();
    callback close-clicked();

    height: 42px;
    background: Theme.kon;

    TouchArea {
        moved => {
            root.move-window(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
        }
    }

    HorizontalLayout {
        padding-left: 14px;

        brand := HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 8px;

            Image {
                width: 24px;
                height: 24px;
                y: (parent.height - self.height) / 2;
                source: @image-url("../../assets/logo_box.png");
                image-fit: contain;
            }
            Text {
                text: "Mugen";
                color: #FFFFFF;
                font-size: 14px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Text {
                text: "Zip";
                color: Theme.sakura;
                font-size: 14px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        Rectangle { horizontal-stretch: 1; }

        WinButton { clicked => { root.minimize-clicked(); } }
        WinButton { close: true; clicked => { root.close-clicked(); } }
    }
}
